{
  "info": {
    "_postman_id": "03bfdbf9-1c7b-4a4a-96ce-b7c612af2171",
    "name": "The Cat API Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "18190646"
  },
  "item": [
    {
      "name": "Get Random Image",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const responseData = pm.response.json();\r",
              "if (responseData && responseData.length > 0) {\r",
              "    const imageId = responseData[0].id;\r",
              "    pm.collectionVariables.set(\"current_image_id\", imageId);\r",
              "    console.log(\"Сохранен image_id: \" + imageId);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/images/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "images",
            "search"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Vote",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Vote created successfully\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "    pm.expect(pm.response.json().message).to.eql(\"SUCCESS\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"image_id\": \"{{current_image_id}}\",\r\n    \"sub_id\": \"my_user_123\",\r\n    \"value\": 1\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/votes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "votes"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add to Favourites",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 or 201\", function () {\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
              "});\r",
              "\r",
              "const res = pm.response.json();\r",
              "if (res && res.id) {\r",
              "    pm.collectionVariables.set(\"fav_id\", res.id);\r",
              "    console.log(\"Сохранен fav_id для очистки данных: \" + res.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"image_id\": \"{{current_image_id}}\",\r\n    \"sub_id\": \"my_user_123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/favourites",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "favourites"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete from Favourites",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Favourite deleted successfully\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.expect(pm.response.json().message).to.eql(\"SUCCESS\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/favourites/{{fav_id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "favourites",
            "{{fav_id}}"
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
